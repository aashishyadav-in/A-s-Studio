import React, { createContext, useContext, useState, useEffect } from 'react';
import {
  Client,
  Shoot,
  Photo,
  Invoice,
  StudioConfig,
  User,
  ShootStatus,
  StudioStage,
  StudioEquipment,
  ClientDocument,
} from '../types';
import {
  defaultClients,
  defaultShoots,
  defaultPhotos,
  defaultInvoices,
  defaultStudioConfig,
  defaultUsers,
  defaultStages,
  defaultEquipment,
  defaultDocuments,
} from '../data/initialData';

interface StudioContextType {
  currentUser: User | null;
  clients: Client[];
  shoots: Shoot[];
  photos: Photo[];
  documents: ClientDocument[];
  invoices: Invoice[];
  studioConfig: StudioConfig;
  allUsers: User[];
  stages: StudioStage[];
  equipment: StudioEquipment[];
  
  // Auth methods
  login: (email: string, passcode?: string) => boolean;
  loginAsUser: (user: User) => void;
  logout: () => void;
  updateClientPasscode: (clientId: string, newPasscode: string) => boolean;
  
  // Client methods
  addClient: (clientData: Omit<Client, 'id' | 'createdAt'>) => Client;
  updateClient: (id: string, updates: Partial<Client>) => void;
  deleteClient: (id: string) => void;
  
  // Shoot methods
  addShoot: (shootData: Omit<Shoot, 'id'>) => Shoot;
  updateShoot: (id: string, updates: Partial<Shoot>) => void;
  updateShootStatus: (id: string, status: ShootStatus) => void;
  deleteShoot: (id: string) => void;
  
  // Photo methods
  addPhoto: (photoData: Omit<Photo, 'id' | 'uploadedAt'>) => Photo;
  togglePhotoSelection: (photoId: string, notes?: string) => void;
  togglePhotoFavorite: (photoId: string) => void;
  updatePhotoNotes: (photoId: string, notes: string) => void;
  deletePhoto: (photoId: string) => void;
  
  // Document methods
  addDocument: (docData: Omit<ClientDocument, 'id' | 'uploadedAt'>) => ClientDocument;
  deleteDocument: (id: string) => void;
  
  // Invoice methods
  addInvoice: (invoiceData: Omit<Invoice, 'id'>) => Invoice;
  updateInvoice: (id: string, updates: Partial<Invoice>) => void;
  recordPayment: (invoiceId: string, amount: number, paymentMethod: string) => void;
  
  // Studio Stages & Equipment methods
  updateStageStatus: (id: string, status: 'Available' | 'In Production' | 'Reserved') => void;
  updateEquipmentStatus: (id: string, status: 'In Vault' | 'Assigned on Shoot' | 'Maintenance') => void;
  
  // Config & Database
  updateStudioConfig: (updates: Partial<StudioConfig>) => void;
  resetToDefaultData: () => void;
  exportDatabaseJson: () => void;
  exportDatabaseSql: () => void;
}

const StudioContext = createContext<StudioContextType | undefined>(undefined);

const STORAGE_KEY = 'aurastudio_storage_v1';

export const StudioProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [currentUser, setCurrentUser] = useState<User | null>(() => {
    try {
      const saved = localStorage.getItem(`${STORAGE_KEY}_user`);
      if (!saved) return null;
      const parsed = JSON.parse(saved);
      return parsed && parsed.id ? parsed : null;
    } catch {
      return null;
    }
  });

  const [clients, setClients] = useState<Client[]>(() => {
    try {
      const saved = localStorage.getItem(`${STORAGE_KEY}_clients`);
      if (!saved) return defaultClients;
      const parsed = JSON.parse(saved);
      return Array.isArray(parsed) && parsed.length > 0 ? parsed : defaultClients;
    } catch {
      return defaultClients;
    }
  });

  const [shoots, setShoots] = useState<Shoot[]>(() => {
    try {
      const saved = localStorage.getItem(`${STORAGE_KEY}_shoots`);
      if (!saved) return defaultShoots;
      const parsed = JSON.parse(saved);
      return Array.isArray(parsed) && parsed.length > 0 ? parsed : defaultShoots;
    } catch {
      return defaultShoots;
    }
  });

  const [photos, setPhotos] = useState<Photo[]>(() => {
    try {
      const saved = localStorage.getItem(`${STORAGE_KEY}_photos`);
      if (!saved) return defaultPhotos;
      const parsed = JSON.parse(saved);
      return Array.isArray(parsed) && parsed.length > 0 ? parsed : defaultPhotos;
    } catch {
      return defaultPhotos;
    }
  });

  const [documents, setDocuments] = useState<ClientDocument[]>(() => {
    try {
      const saved = localStorage.getItem(`${STORAGE_KEY}_documents`);
      if (!saved) return defaultDocuments;
      const parsed = JSON.parse(saved);
      return Array.isArray(parsed) && parsed.length > 0 ? parsed : defaultDocuments;
    } catch {
      return defaultDocuments;
    }
  });

  const [invoices, setInvoices] = useState<Invoice[]>(() => {
    try {
      const saved = localStorage.getItem(`${STORAGE_KEY}_invoices`);
      if (!saved) return defaultInvoices;
      const parsed = JSON.parse(saved);
      return Array.isArray(parsed) && parsed.length > 0 ? parsed : defaultInvoices;
    } catch {
      return defaultInvoices;
    }
  });

  const [stages, setStages] = useState<StudioStage[]>(() => {
    try {
      const saved = localStorage.getItem(`${STORAGE_KEY}_stages`);
      if (!saved) return defaultStages;
      const parsed = JSON.parse(saved);
      return Array.isArray(parsed) && parsed.length > 0 ? parsed : defaultStages;
    } catch {
      return defaultStages;
    }
  });

  const [equipment, setEquipment] = useState<StudioEquipment[]>(() => {
    try {
      const saved = localStorage.getItem(`${STORAGE_KEY}_equipment`);
      if (!saved) return defaultEquipment;
      const parsed = JSON.parse(saved);
      return Array.isArray(parsed) && parsed.length > 0 ? parsed : defaultEquipment;
    } catch {
      return defaultEquipment;
    }
  });

  const [studioConfig, setStudioConfig] = useState<StudioConfig>(() => {
    try {
      const saved = localStorage.getItem(`${STORAGE_KEY}_config`);
      if (!saved) return defaultStudioConfig;
      const parsed = JSON.parse(saved);
      if (parsed && typeof parsed === 'object') {
        return {
          ...defaultStudioConfig,
          ...parsed,
          studioName: 'A-S Studio',
          email: 'contact@as-studio.com',
        };
      }
      return defaultStudioConfig;
    } catch {
      return defaultStudioConfig;
    }
  });

  // Save changes to localStorage
  useEffect(() => {
    localStorage.setItem(`${STORAGE_KEY}_clients`, JSON.stringify(clients));
  }, [clients]);

  useEffect(() => {
    localStorage.setItem(`${STORAGE_KEY}_shoots`, JSON.stringify(shoots));
  }, [shoots]);

  useEffect(() => {
    localStorage.setItem(`${STORAGE_KEY}_photos`, JSON.stringify(photos));
  }, [photos]);

  useEffect(() => {
    localStorage.setItem(`${STORAGE_KEY}_documents`, JSON.stringify(documents));
  }, [documents]);

  useEffect(() => {
    localStorage.setItem(`${STORAGE_KEY}_invoices`, JSON.stringify(invoices));
  }, [invoices]);

  // INVOICES_MONGODB_SYNC
  useEffect(() => {
    const token = localStorage.getItem("aurastudio_auth_token");
    if (!currentUser || currentUser.role !== "ADMIN" || !token) return;

    let cancelled = false;

    const syncInvoices = async () => {
      const base = `${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/invoices`;

      try {
        const migration = await fetch(`${base}/migrate`, {
          method: "POST",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ invoices }),
        });

        if (!migration.ok) {
          const result = await migration.json().catch(() => ({}));
          throw new Error(result.message || `Invoice migration failed (${migration.status})`);
        }

        const response = await fetch(base, {
          headers: { Authorization: `Bearer ${token}` },
        });

        if (!response.ok) throw new Error(`Invoice load failed (${response.status})`);

        const rows = await response.json();
        if (!cancelled && Array.isArray(rows)) setInvoices(rows);
      } catch (error) {
        console.error("Invoice MongoDB sync failed:", error);
      }
    };

    void syncInvoices();
    return () => { cancelled = true; };
  }, [currentUser]);

  useEffect(() => {

  // STUDIO_DATA_MONGODB_SYNC: migrate local records once per admin login, then load MongoDB state.
  useEffect(() => {
    const token = localStorage.getItem("aurastudio_auth_token");
    if (!currentUser || currentUser.role !== "ADMIN" || !token) return;
    let cancelled = false;

    const syncStudioData = async () => {
      const base = `${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/studio-data`;
      const migration = await fetch(`${base}/migrate`, {
        method: "POST",
        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: JSON.stringify({ stages, equipment, studioConfig, documents }),
      });
      if (!migration.ok) {
        const result = await migration.json().catch(() => ({}));
        throw new Error(result.message || `Studio data migration failed (${migration.status})`);
      }
      const response = await fetch(base, { headers: { Authorization: `Bearer ${token}` } });
      if (!response.ok) throw new Error(`Studio data load failed (${response.status})`);
      const result = await response.json();
      if (cancelled) return;
      if (Array.isArray(result.stages)) setStages(result.stages);
      if (Array.isArray(result.equipment)) setEquipment(result.equipment);
      if (Array.isArray(result.documents)) setDocuments(result.documents);
      if (result.studioConfig && typeof result.studioConfig === "object") setStudioConfig(result.studioConfig);
    };

    void syncStudioData().catch(error => console.error("Studio data MongoDB sync failed:", error));
    return () => { cancelled = true; };
  }, [currentUser]);

    localStorage.setItem(`${STORAGE_KEY}_stages`, JSON.stringify(stages));
  }, [stages]);

  useEffect(() => {
    localStorage.setItem(`${STORAGE_KEY}_equipment`, JSON.stringify(equipment));
  }, [equipment]);

  useEffect(() => {
    localStorage.setItem(`${STORAGE_KEY}_config`, JSON.stringify(studioConfig));
  }, [studioConfig]);


  // CLIENTS_MONGODB_SYNC
  useEffect(() => {
    const token = localStorage.getItem("aurastudio_auth_token");
    if (!currentUser || currentUser.role !== "ADMIN" || !token) return;
    let cancelled = false;
    const sync = async () => {
      const base = `${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/clients`;
      try {
        const migrated = await fetch(`${base}/migrate`, {
          method: "POST",
          headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: JSON.stringify({ clients })
        });
        if (!migrated.ok) throw new Error(`Client migration failed (${migrated.status})`);
        const response = await fetch(base, { headers: { Authorization: `Bearer ${token}` } });
        if (!response.ok) throw new Error(`Client list failed (${response.status})`);
        const rows = await response.json();
        if (cancelled || !Array.isArray(rows)) return;
        setClients(previous => {
          const old = new Map(previous.map(x => [x.id, x]));
          const merged = rows.map(x => ({ ...x, accessPasscode: old.get(x.id)?.accessPasscode || "" }));
          return merged.length ? merged : previous;
        });
      } catch (e) { console.error("Client MongoDB sync failed:", e); }
    };
    void sync();
    return () => { cancelled = true; };
  }, [currentUser]);

  // Load the authenticated user's gallery from the backend.
  useEffect(() => {
    const token = localStorage.getItem('aurastudio_auth_token');

    if (!currentUser || !token) return;

    let cancelled = false;

    const loadGallery = async () => {
      try {
        const response = await fetch(
          `${import.meta.env.VITE_API_URL || 'http://localhost:5001'}/api/gallery/me`,
          {
            headers: {
              Authorization: `Bearer ${token}`,
            },
          }
        );

        if (!response.ok) {
          throw new Error(`Gallery request failed: ${response.status}`);
        }

        const data = await response.json();

        if (cancelled) return;

        if (Array.isArray(data.shoots) && Array.isArray(data.photos)) {
          setShoots(data.shoots);
          setPhotos(data.photos);
        }
      } catch (error) {
        console.error('Unable to load gallery from backend:', error);
      }
    };

    void loadGallery();

    return () => {
      cancelled = true;
    };
  }, [currentUser]);

  // Auth
  const login = (identifier: string, passcode?: string): boolean => {
    const cleanId = identifier.trim().toLowerCase();
    
    // Check Admin
    

    // Check Client by Email or Client Code or Passcode
    const matchedClient = clients.find(
      (c) =>
        c.email.toLowerCase() === cleanId ||
        c.clientCode.toLowerCase() === cleanId ||
        (passcode && c.accessPasscode.toLowerCase() === passcode.trim().toLowerCase())
    );

    if (matchedClient) {
      const user: User = {
        id: `usr-${matchedClient.id}`,
        name: matchedClient.name,
        email: matchedClient.email,
        role: 'CLIENT',
        clientId: matchedClient.id,
        avatar: matchedClient.avatar,
        phone: matchedClient.phone,
      };
      setCurrentUser(user);
      try {
        localStorage.setItem(`${STORAGE_KEY}_user`, JSON.stringify(user));
      } catch {
        // ignore storage errors
      }
      return true;
    }

    return false;
  };

  const loginAsUser = (user: User) => {
    setCurrentUser(user);
    try {
      localStorage.setItem(`${STORAGE_KEY}_user`, JSON.stringify(user));
    } catch {
      // ignore
    }
  };

  const logout = () => {
    setCurrentUser(null);
    try {
      localStorage.removeItem(`${STORAGE_KEY}_user`);
      localStorage.removeItem('aurastudio_auth_token');
    } catch {
      // ignore
    }
  };

  const updateClientPasscode = (clientId: string, newPasscode: string): boolean => {
    if (!newPasscode || !newPasscode.trim()) return false;
    const cleanPass = newPasscode.trim();
    setClients((prev) =>
      prev.map((c) => (c.id === clientId ? { ...c, accessPasscode: cleanPass } : c))
    );
    return true;
  };

  const persistGallery = async (
    path: string,
    method: "POST" | "PATCH" | "DELETE",
    body?: unknown
  ): Promise<void> => {
    const token = localStorage.getItem("aurastudio_auth_token");

    if (!token) {
      throw new Error("Login session missing. Please log in again.");
    }

    const response = await fetch(
      `${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/gallery${path}`,
      {
        method,
        headers: {
          Authorization: `Bearer ${token}`,
          ...(body !== undefined ? { "Content-Type": "application/json" } : {}),
        },
        ...(body !== undefined ? { body: JSON.stringify(body) } : {}),
      }
    );

    if (!response.ok) {
      const result = await response.json().catch(() => ({}));
      throw new Error(result.message || `Save failed (${response.status})`);
    }
  };

  const persistGalleryInBackground = (
    path: string,
    method: "POST" | "PATCH" | "DELETE",
    body?: unknown
  ) => {
    void persistGallery(path, method, body).catch((error) => {
      console.error("Gallery persistence failed:", error);
      alert(
        error instanceof Error
          ? `MongoDB save failed: ${error.message}`
          : "MongoDB save failed. Please try again."
      );
    });
  };


  // Client operations
  const addClient = (clientData: Omit<Client, 'id' | 'createdAt'>): Client => {
    const newId = `clt-${Date.now().toString().slice(-4)}`;
    const newClient: Client = {
      ...clientData,
      id: newId,
      createdAt: new Date().toISOString().split('T')[0],
    };

    setClients((prev) => [newClient, ...prev]);

    // Persist clients to MongoDB as well as local state.
    const token = localStorage.getItem('aurastudio_auth_token');
    if (token) {
      const clientsToSync = [newClient, ...clients];
      void fetch(
        `${import.meta.env.VITE_API_URL || 'http://localhost:5001'}/api/clients/migrate`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({ clients: clientsToSync }),
        }
      )
        .then(async (response) => {
          const result = await response.json().catch(() => ({}));
          if (!response.ok) {
            throw new Error(result.message || `HTTP ${response.status}`);
          }
          if (result.errors?.length) {
            console.error('Some clients could not be synced:', result.errors);
          }
          console.log(
            `Client sync complete: ${result.created} created, ${result.skipped} already existed.`
          );
        })
        .catch((error) => {
          console.error('Client MongoDB sync failed:', error);
          alert('Client is saved locally, but MongoDB sync failed. Check the browser console.');
        });
    } else {
      console.error('Client MongoDB sync skipped: admin auth token is missing.');
    }

    return newClient;
  };

  const updateClient = async (id: string, updates: Partial<Client>) => {
    const token = localStorage.getItem("aurastudio_auth_token");
    if (!token) {
      alert("Please log in again before updating a client.");
      return;
    }

    try {
      const response = await fetch(
        `${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/clients/${encodeURIComponent(id)}`,
        {
          method: "PATCH",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify(updates),
        }
      );
      const result = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(result.message || `Update failed (${response.status})`);
      }

      setClients((prev) =>
        prev.map((c) => (c.id === id ? { ...c, ...updates } : c))
      );
    } catch (error) {
      console.error("Client update failed:", error);
      alert(error instanceof Error ? error.message : "Client update failed.");
    }
  };

  const deleteClient = async (id: string) => {
    const token = localStorage.getItem("aurastudio_auth_token");
    if (!token) {
      alert("Please log in again before deleting a client.");
      return;
    }

    if (!window.confirm(
      "Permanently delete this client and their associated shoots, photos, and client account?"
    )) return;

    try {
      const response = await fetch(
        `${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/clients/${encodeURIComponent(id)}`,
        {
          method: "DELETE",
          headers: { Authorization: `Bearer ${token}` },
        }
      );
      const result = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(result.message || `Delete failed (${response.status})`);
      }

      setClients((prev) => prev.filter((c) => c.id !== id));
      setShoots((prev) => prev.filter((s) => s.clientId !== id));
      setInvoices((prev) => prev.filter((i) => i.clientId !== id));
    } catch (error) {
      console.error("Client deletion failed:", error);
      alert(error instanceof Error ? error.message : "Client deletion failed.");
    }
  };

 
  // Shoot operations
  const addShoot = (shootData: Omit<Shoot, 'id'>): Shoot => {
    const newShoot: Shoot = {
      ...shootData,
      id: `sht-${Date.now()}`,
    };

    setShoots((prev) => [newShoot, ...prev]);
    persistGalleryInBackground("/shoots", "POST", newShoot);

    return newShoot;
  };

  const updateShoot = (id: string, updates: Partial<Shoot>) => {
    setShoots((prev) =>
      prev.map((shoot) =>
        shoot.id === id ? { ...shoot, ...updates } : shoot
      )
    );

    persistGalleryInBackground(
      `/shoots/${encodeURIComponent(id)}`,
      "PATCH",
      updates
    );
  };

  const updateShootStatus = (id: string, status: ShootStatus) => {
    updateShoot(id, { status });
  };

  const deleteShoot = (id: string) => {
    setShoots((prev) => prev.filter((shoot) => shoot.id !== id));
    setPhotos((prev) => prev.filter((photo) => photo.shootId !== id));

    persistGalleryInBackground(
      `/shoots/${encodeURIComponent(id)}`,
      "DELETE"
    );
  };

  // Photo operations
  const addPhoto = (photoData: Omit<Photo, 'id' | 'uploadedAt'>): Photo => {
    const newPhoto: Photo = {
      ...photoData,
      id: `pht-${Date.now()}`,
      uploadedAt: new Date().toISOString().split('T')[0],
    };

    setPhotos((prev) => [newPhoto, ...prev]);
    persistGalleryInBackground("/photos", "POST", newPhoto);

    return newPhoto;
  };

  
  const savePhotoChanges = async (
    photoId: string,
    updates: {
      isSelectedForAlbum?: boolean;
      isFavorite?: boolean;
      clientNotes?: string;
    }
  ) => {
    const token = localStorage.getItem('aurastudio_auth_token');

    if (!token) {
      alert('Please log in again to save gallery changes.');
      return false;
    }

    try {
      const response = await fetch(
        `${import.meta.env.VITE_API_URL || 'http://localhost:5001'}/api/gallery/photos/${encodeURIComponent(photoId)}`,
        {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify(updates),
        }
      );

      if (!response.ok) {
        const result = await response.json().catch(() => ({}));
        throw new Error(result.message || `Request failed (${response.status})`);
      }

      return true;
    } catch (error) {
      console.error('Failed to save photo changes:', error);
      alert(
        error instanceof Error
          ? error.message
          : 'Could not save gallery changes.'
      );
      return false;
    }
  };

  const togglePhotoSelection = async (
    photoId: string,
    notes?: string
  ) => {
    const photo = photos.find((p) => p.id === photoId);
    if (!photo) return;

    const updates = {
      isSelectedForAlbum: !photo.isSelectedForAlbum,
      ...(notes !== undefined ? { clientNotes: notes } : {}),
    };

    if (!(await savePhotoChanges(photoId, updates))) return;

    setPhotos((prev) =>
      prev.map((p) => (p.id === photoId ? { ...p, ...updates } : p))
    );
  };

  const togglePhotoFavorite = async (photoId: string) => {
    const photo = photos.find((p) => p.id === photoId);
    if (!photo) return;

    const updates = { isFavorite: !photo.isFavorite };

    if (!(await savePhotoChanges(photoId, updates))) return;

    setPhotos((prev) =>
      prev.map((p) => (p.id === photoId ? { ...p, ...updates } : p))
    );
  };

  const updatePhotoNotes = async (photoId: string, notes: string) => {
    const updates = { clientNotes: notes };

    if (!(await savePhotoChanges(photoId, updates))) return;

    setPhotos((prev) =>
      prev.map((p) => (p.id === photoId ? { ...p, ...updates } : p))
    );
  };

  const deletePhoto = (photoId: string) => {
    setPhotos((prev) => prev.filter((p) => p.id !== photoId));

    persistGalleryInBackground(
      `/photos/${encodeURIComponent(photoId)}`,
      "DELETE"
    );
  };

  // Document operations
  const addDocument = (docData: Omit<ClientDocument, 'id' | 'uploadedAt'>): ClientDocument => {
    const newDoc: ClientDocument = {
      ...docData,
      id: `doc-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
      uploadedAt: new Date().toISOString().split('T')[0],
    };
    setDocuments((prev) => [newDoc, ...prev]);
    const token = localStorage.getItem("aurastudio_auth_token");
    if (token) {
      void fetch(`${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/studio-data/documents`, {
        method: "POST",
        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: JSON.stringify(newDoc),
      }).then(async response => {
        if (!response.ok) {
          const result = await response.json().catch(() => ({}));
          throw new Error(result.message || `Document save failed (${response.status})`);
        }
      }).catch(error => {
        console.error("Document MongoDB save failed:", error);
        alert("Document metadata could not be saved to MongoDB. Check the console.");
      });
    } else {
      alert("Document is only saved locally. Log in as admin to sync it to MongoDB.");
    }
    return newDoc;
  };

  const deleteDocument = (id: string) => {
    const token = localStorage.getItem("aurastudio_auth_token");
    if (!token) {
      alert("Please log in as admin before deleting a document.");
      return;
    }
    void fetch(`${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/studio-data/documents/${encodeURIComponent(id)}`, {
      method: "DELETE",
      headers: { Authorization: `Bearer ${token}` },
    }).then(async response => {
      if (!response.ok) {
        const result = await response.json().catch(() => ({}));
        throw new Error(result.message || `Document delete failed (${response.status})`);
      }
      setDocuments((prev) => prev.filter((d) => d.id !== id));
    }).catch(error => {
      console.error("Document MongoDB delete failed:", error);
      alert(error instanceof Error ? error.message : "Document delete failed.");
    });
  };

  // Invoice operations
  const addInvoice = (invoiceData: Omit<Invoice, 'id'>): Invoice => {
    const newInvoice: Invoice = {
      ...invoiceData,
      id: `inv-${Date.now().toString().slice(-4)}-${Math.random().toString(36).slice(2, 7)}`,
    };

    setInvoices((prev) => [newInvoice, ...prev]);

    const token = localStorage.getItem("aurastudio_auth_token");
    if (!token) {
      alert("Invoice is only saved locally: please log in to sync it to MongoDB.");
      return newInvoice;
    }

    void fetch(
      `${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/invoices`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify(newInvoice),
      }
    )
      .then(async (response) => {
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.message || `Save failed (${response.status})`);
        setInvoices((prev) => prev.map((inv) => inv.id === newInvoice.id ? result : inv));
      })
      .catch((error) => {
        console.error("Invoice MongoDB save failed:", error);
        alert("Invoice could not be saved to MongoDB. Check the console before relying on this invoice.");
      });

    return newInvoice;
  };

  const updateInvoice = (id: string, updates: Partial<Invoice>) => {
    const token = localStorage.getItem("aurastudio_auth_token");
    if (!token) {
      alert("Please log in again before updating an invoice.");
      return;
    }

    void fetch(
      `${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/invoices/${encodeURIComponent(id)}`,
      {
        method: "PATCH",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify(updates),
      }
    )
      .then(async (response) => {
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.message || `Update failed (${response.status})`);
        setInvoices((prev) => prev.map((inv) => inv.id === id ? result : inv));
      })
      .catch((error) => {
        console.error("Invoice MongoDB update failed:", error);
        alert(error instanceof Error ? error.message : "Invoice update failed.");
      });
  };

  const recordPayment = (invoiceId: string, amount: number, paymentMethod: string) => {
    if (!Number.isFinite(amount) || amount <= 0) {
      alert("Enter a valid payment amount.");
      return;
    }

    const token = localStorage.getItem("aurastudio_auth_token");
    if (!token) {
      alert("Please log in again before recording a payment.");
      return;
    }

    void fetch(
      `${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/invoices/${encodeURIComponent(invoiceId)}/payments`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ amount, paymentMethod }),
      }
    )
      .then(async (response) => {
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.message || `Payment save failed (${response.status})`);
        setInvoices((prev) => prev.map((inv) => inv.id === invoiceId ? result : inv));
      })
      .catch((error) => {
        console.error("Payment MongoDB save failed:", error);
        alert(error instanceof Error ? error.message : "Payment could not be saved.");
      });
  };

  const updateStageStatus = (id: string, status: 'Available' | 'In Production' | 'Reserved') => {
    const token = localStorage.getItem("aurastudio_auth_token");
    if (!token) { alert("Please log in as admin to update studio stages."); return; }
    void fetch(`${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/studio-data/stages/${encodeURIComponent(id)}`, {
      method: "PATCH",
      headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
      body: JSON.stringify({ status }),
    }).then(async response => {
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.message || `Stage update failed (${response.status})`);
      setStages(prev => prev.map(stg => stg.id === id ? { ...stg, status } : stg));
    }).catch(error => {
      console.error("Stage MongoDB update failed:", error);
      alert(error instanceof Error ? error.message : "Stage update failed.");
    });
  };

  const updateEquipmentStatus = (id: string, status: 'In Vault' | 'Assigned on Shoot' | 'Maintenance') => {
    const token = localStorage.getItem("aurastudio_auth_token");
    if (!token) { alert("Please log in as admin to update equipment."); return; }
    void fetch(`${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/studio-data/equipment/${encodeURIComponent(id)}`, {
      method: "PATCH",
      headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
      body: JSON.stringify({ status }),
    }).then(async response => {
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.message || `Equipment update failed (${response.status})`);
      setEquipment(prev => prev.map(eq => eq.id === id ? { ...eq, status } : eq));
    }).catch(error => {
      console.error("Equipment MongoDB update failed:", error);
      alert(error instanceof Error ? error.message : "Equipment update failed.");
    });
  };

  const updateStudioConfig = (updates: Partial<StudioConfig>) => {
    const token = localStorage.getItem("aurastudio_auth_token");
    if (!token) { alert("Please log in as admin to update studio settings."); return; }
    void fetch(`${import.meta.env.VITE_API_URL || "http://localhost:5001"}/api/studio-data/config`, {
      method: "PATCH",
      headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
      body: JSON.stringify(updates),
    }).then(async response => {
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.message || `Settings update failed (${response.status})`);
      setStudioConfig(result);
    }).catch(error => {
      console.error("Studio config MongoDB update failed:", error);
      alert(error instanceof Error ? error.message : "Studio settings update failed.");
    });
  };

  const resetToDefaultData = () => {
    localStorage.removeItem(`${STORAGE_KEY}_clients`);
    localStorage.removeItem(`${STORAGE_KEY}_shoots`);
    localStorage.removeItem(`${STORAGE_KEY}_photos`);
    localStorage.removeItem(`${STORAGE_KEY}_invoices`);
    localStorage.removeItem(`${STORAGE_KEY}_stages`);
    localStorage.removeItem(`${STORAGE_KEY}_equipment`);
    localStorage.removeItem(`${STORAGE_KEY}_config`);
    setClients(defaultClients);
    setShoots(defaultShoots);
    setPhotos(defaultPhotos);
    setInvoices(defaultInvoices);
    setStages(defaultStages);
    setEquipment(defaultEquipment);
    setStudioConfig(defaultStudioConfig);
    setCurrentUser(defaultUsers[0]);
  };

  const exportDatabaseJson = () => {
    const exportData = {
      exportDate: new Date().toISOString(),
      studioConfig,
      clients,
      shoots,
      photos,
      invoices,
    };
    const blob = new Blob([JSON.stringify(exportData, null, 2)], {
      type: 'application/json',
    });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `aurastudio_database_backup_${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const exportDatabaseSql = () => {
    let sql = `-- AuraStudio Official Database Export\n-- Generated on: ${new Date().toISOString()}\n\n`;
    
    // Clients
    sql += `-- Clients Dump\n`;
    clients.forEach((c) => {
      sql += `INSERT INTO clients (id, client_code, name, email, phone, city, access_passcode, notes, created_at) VALUES ('${c.id}', '${c.clientCode}', '${c.name.replace(/'/g, "''")}', '${c.email}', '${c.phone}', '${c.city}', '${c.accessPasscode}', '${(c.notes || '').replace(/'/g, "''")}', '${c.createdAt}');\n`;
    });

    // Shoots
    sql += `\n-- Shoots Dump\n`;
    shoots.forEach((s) => {
      sql += `INSERT INTO shoots (id, client_id, title, shoot_type, event_date, venue, lead_photographer, status, package_title, total_amount, advance_paid, balance_due) VALUES ('${s.id}', '${s.clientId}', '${s.title.replace(/'/g, "''")}', '${s.type}', '${s.eventDate}', '${s.venue.replace(/'/g, "''")}', '${s.leadPhotographer}', '${s.status}', '${s.packageTitle.replace(/'/g, "''")}', ${s.totalAmount}, ${s.advancePaid}, ${s.balanceDue});\n`;
    });

    // Invoices
    sql += `\n-- Invoices Dump\n`;
    invoices.forEach((inv) => {
      sql += `INSERT INTO invoices (id, invoice_number, client_id, issue_date, due_date, subtotal, tax_rate, tax_amount, discount, total_amount, paid_amount, status) VALUES ('${inv.id}', '${inv.invoiceNumber}', '${inv.clientId}', '${inv.issueDate}', '${inv.dueDate}', ${inv.subtotal}, ${inv.taxRate}, ${inv.taxAmount}, ${inv.discount}, ${inv.totalAmount}, ${inv.paidAmount}, '${inv.status}');\n`;
    });

    const blob = new Blob([sql], { type: 'text/sql' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `aurastudio_export_${new Date().toISOString().split('T')[0]}.sql`;
    a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <StudioContext.Provider
      value={{
        currentUser,
        clients,
        shoots,
        photos,
        documents,
        invoices,
        studioConfig,
        allUsers: defaultUsers,
        login,
        loginAsUser,
        logout,
        updateClientPasscode,
        addClient,
        updateClient,
        deleteClient,
        addShoot,
        updateShoot,
        updateShootStatus,
        deleteShoot,
        addPhoto,
        togglePhotoSelection,
        togglePhotoFavorite,
        updatePhotoNotes,
        deletePhoto,
        addDocument,
        deleteDocument,
        addInvoice,
        updateInvoice,
        recordPayment,
        updateStudioConfig,
        stages,
        equipment,
        updateStageStatus,
        updateEquipmentStatus,
        resetToDefaultData,
        exportDatabaseJson,
        exportDatabaseSql,
      }}
    >
      {children}
    </StudioContext.Provider>
  );
};

export const useStudio = () => {
  const context = useContext(StudioContext);
  if (!context) {
    throw new Error('useStudio must be used within a StudioProvider');
  }
  return context;
};
