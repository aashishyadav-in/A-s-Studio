import React, { useState } from 'react';
import { useStudio } from '../../context/StudioContext';
import { Shoot, ShootStatus, ShootType, Photo } from '../../types';
import { PhotoLightbox } from '../common/PhotoLightbox';
import {
  Camera,
  Plus,
  Search,
  Filter,
  ExternalLink,
  CheckCircle2,
  Clock,
  Sparkles,
  Calendar,
  MapPin,
  User,
  DollarSign,
  Heart,
  Check,
  X,
  Upload,
} from 'lucide-react';

interface ShootsManagerProps {
  initialClientId?: string;
  onOpenNewShoot: () => void;
}

export const ShootsManager: React.FC<ShootsManagerProps> = ({
  initialClientId,
  onOpenNewShoot,
}) => {
  const { shoots, clients, photos, updateShootStatus, updateShoot, addPhoto } = useStudio();
  const [selectedType, setSelectedType] = useState<string>('all');
  const [selectedStatus, setSelectedStatus] = useState<string>('all');
  const [selectedShoot, setSelectedShoot] = useState<Shoot | null>(null);
  const [lightboxOpen, setLightboxOpen] = useState(false);
  const [currentPhotoIdx, setCurrentPhotoIdx] = useState(0);

  // New photo modal state
  const [isAddPhotoOpen, setIsAddPhotoOpen] = useState(false);
  const [newPhotoUrl, setNewPhotoUrl] = useState('');
  const [newPhotoTitle, setNewPhotoTitle] = useState('');
  const [newPhotoCategory, setNewPhotoCategory] = useState('Highlights');

  const filteredShoots = shoots.filter((s) => {
    if (initialClientId && s.clientId !== initialClientId) return false;
    if (selectedType !== 'all' && s.type !== selectedType) return false;
    if (selectedStatus !== 'all' && s.status !== selectedStatus) return false;
    return true;
  });

  const getClient = (clientId: string) => clients.find((c) => c.id === clientId);

  const getShootPhotos = (shootId: string) => photos.filter((p) => p.shootId === shootId);

  const handleAddPhotoSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedShoot || !newPhotoUrl) return;

    addPhoto({
      shootId: selectedShoot.id,
      url: newPhotoUrl,
      title: newPhotoTitle || 'Studio Shot',
      category: newPhotoCategory,
      isSelectedForAlbum: false,
      isFavorite: false,
      resolution: '8256 x 5504 (45MP)',
    });

    setNewPhotoUrl('');
    setNewPhotoTitle('');
    setIsAddPhotoOpen(false);
  };

  return (
    <div className="space-y-6">
      {/* Top Bar */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-neutral-800">
        <div>
          <h1 className="text-xl font-bold tracking-tight text-white flex items-center gap-2">
            <Camera className="w-5 h-5 text-amber-500" />
            <span>Shoots &amp; Photo Proofing Hub</span>
          </h1>
          <p className="text-xs text-neutral-400 mt-1">
            Manage client-wise production shoots, photo proofing galleries, and cloud deliverables.
          </p>
        </div>

        <button
          onClick={onOpenNewShoot}
          className="flex items-center gap-1.5 px-3 py-1.5 bg-amber-500 hover:bg-amber-400 text-neutral-950 text-xs font-semibold rounded-lg transition-colors whitespace-nowrap self-start sm:self-auto"
        >
          <Plus className="w-3.5 h-3.5" />
          <span>Book New Shoot</span>
        </button>
      </div>

      {/* Filters */}
      <div className="flex flex-wrap items-center gap-2">
        <div className="flex items-center gap-1 p-1 bg-neutral-900 border border-neutral-800 rounded-lg text-xs">
          <button
            onClick={() => setSelectedType('all')}
            className={`px-2.5 py-1 rounded transition-colors ${
              selectedType === 'all'
                ? 'bg-neutral-800 text-white font-medium'
                : 'text-neutral-400 hover:text-white'
            }`}
          >
            All Types
          </button>
          {['Wedding', 'Pre-Wedding', 'Fashion', 'Portrait'].map((type) => (
            <button
              key={type}
              onClick={() => setSelectedType(type)}
              className={`px-2.5 py-1 rounded transition-colors ${
                selectedType === type
                  ? 'bg-neutral-800 text-white font-medium'
                  : 'text-neutral-400 hover:text-white'
              }`}
            >
              {type}
            </button>
          ))}
        </div>

        <div className="flex items-center gap-1 p-1 bg-neutral-900 border border-neutral-800 rounded-lg text-xs">
          <button
            onClick={() => setSelectedStatus('all')}
            className={`px-2.5 py-1 rounded transition-colors ${
              selectedStatus === 'all'
                ? 'bg-neutral-800 text-white font-medium'
                : 'text-neutral-400 hover:text-white'
            }`}
          >
            All Status
          </button>
          {['Booked', 'Editing', 'Proofing', 'Completed'].map((status) => (
            <button
              key={status}
              onClick={() => setSelectedStatus(status)}
              className={`px-2.5 py-1 rounded transition-colors ${
                selectedStatus === status
                  ? 'bg-neutral-800 text-white font-medium'
                  : 'text-neutral-400 hover:text-white'
              }`}
            >
              {status}
            </button>
          ))}
        </div>
      </div>

      {/* Shoots Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {filteredShoots.map((shoot) => {
          const client = getClient(shoot.clientId);
          const shootPhotos = getShootPhotos(shoot.id);
          const selectedCount = shootPhotos.filter((p) => p.isSelectedForAlbum).length;

          return (
            <div
              key={shoot.id}
              onClick={() => setSelectedShoot(shoot)}
              className="rounded-xl border border-neutral-800 bg-neutral-900/60 hover:bg-neutral-900 hover:border-neutral-700 transition-all overflow-hidden cursor-pointer group flex flex-col"
            >
              {/* Cover Image */}
              <div className="relative h-44 w-full overflow-hidden bg-neutral-950">
                <img
                  src={shoot.coverImage}
                  alt={shoot.title}
                  referrerPolicy="no-referrer"
                  className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/20 to-transparent" />

                <div className="absolute top-3 left-3">
                  <span className="px-2 py-0.5 rounded text-[10px] font-medium bg-neutral-900/90 text-white border border-neutral-700/80 backdrop-blur-sm">
                    {shoot.type}
                  </span>
                </div>

                <div className="absolute top-3 right-3">
                  <span className="px-2 py-0.5 rounded text-[10px] font-medium bg-amber-500/90 text-neutral-950 font-semibold backdrop-blur-sm">
                    {shoot.status.replace('_', ' ')}
                  </span>
                </div>

                <div className="absolute bottom-3 left-3 right-3">
                  <div className="text-white font-bold text-sm truncate">{shoot.title}</div>
                  <div className="text-neutral-300 text-[11px] truncate mt-0.5">
                    Client: {client?.name} ({client?.clientCode})
                  </div>
                </div>
              </div>

              {/* Details Body */}
              <div className="p-4 space-y-3 flex-1 flex flex-col justify-between text-xs">
                <div className="space-y-1.5 text-neutral-400">
                  <div className="flex items-center gap-1.5">
                    <Calendar className="w-3.5 h-3.5 text-neutral-500 shrink-0" />
                    <span className="font-mono">{shoot.eventDate}</span>
                  </div>
                  <div className="flex items-center gap-1.5 truncate">
                    <MapPin className="w-3.5 h-3.5 text-neutral-500 shrink-0" />
                    <span className="truncate">{shoot.venue}</span>
                  </div>
                  <div className="flex items-center gap-1.5">
                    <User className="w-3.5 h-3.5 text-neutral-500 shrink-0" />
                    <span>Lead: {shoot.leadPhotographer}</span>
                  </div>
                </div>

                {/* Proofing Progress Bar */}
                <div className="pt-2 border-t border-neutral-800">
                  <div className="flex items-center justify-between text-[11px] mb-1">
                    <span className="text-neutral-400">Client Album Selection:</span>
                    <span className="font-mono font-medium text-amber-400">
                      {selectedCount} photos chosen
                    </span>
                  </div>
                  <div className="w-full h-1.5 bg-neutral-800 rounded-full overflow-hidden">
                    <div
                      className="h-full bg-amber-500 rounded-full transition-all duration-300"
                      style={{ width: `${Math.min(100, (selectedCount / 50) * 100)}%` }}
                    />
                  </div>
                </div>

                {/* Footer Amounts */}
                <div className="pt-2 border-t border-neutral-800 flex items-center justify-between text-[11px]">
                  <span className="text-neutral-500">
                    Total: ₹{shoot.totalAmount.toLocaleString('en-IN')}
                  </span>
                  <span className="text-amber-400 font-mono font-medium">
                    Due: ₹{shoot.balanceDue.toLocaleString('en-IN')}
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      {/* Shoot Detail Modal / Gallery Manager */}
      {selectedShoot && (
        <div className="fixed inset-0 z-50 overflow-y-auto bg-neutral-950/85 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="relative w-full max-w-4xl bg-neutral-900 border border-neutral-800 rounded-xl shadow-2xl overflow-hidden my-6">
            {/* Header */}
            <div className="flex items-center justify-between px-6 py-4 border-b border-neutral-800 bg-neutral-950/50">
              <div>
                <div className="flex items-center gap-2">
                  <h2 className="text-base font-bold text-white">{selectedShoot.title}</h2>
                  <span className="text-xs px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30 font-medium">
                    {selectedShoot.status.replace('_', ' ')}
                  </span>
                </div>
                <div className="text-xs text-neutral-400 mt-0.5">
                  Client: {getClient(selectedShoot.clientId)?.name} · Date: {selectedShoot.eventDate}
                </div>
              </div>

              <div className="flex items-center gap-2">
                {/* Status Switcher */}
                <select
                  value={selectedShoot.status}
                  onChange={(e) => {
                    const newStatus = e.target.value as ShootStatus;
                    updateShootStatus(selectedShoot.id, newStatus);
                    setSelectedShoot({ ...selectedShoot, status: newStatus });
                  }}
                  className="bg-neutral-800 border border-neutral-700 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-amber-500"
                >
                  <option value="Booked">Status: Booked</option>
                  <option value="Shot_Completed">Status: Shot Completed</option>
                  <option value="Editing">Status: In Color Grading</option>
                  <option value="Proofing">Status: Client Proofing</option>
                  <option value="Album_Design">Status: Album Designing</option>
                  <option value="Completed">Status: Fully Completed</option>
                </select>

                <button
                  onClick={() => setSelectedShoot(null)}
                  className="p-1.5 text-neutral-400 hover:text-white rounded-lg hover:bg-neutral-800"
                >
                  <X className="w-4 h-4" />
                </button>
              </div>
            </div>

            {/* Modal Body */}
            <div className="p-6 space-y-6 max-h-[75vh] overflow-y-auto">
              {/* Deliverable Cloud Drive Links */}
              <div className="p-4 rounded-xl bg-neutral-950 border border-neutral-800 space-y-3">
                <div className="text-xs font-semibold text-neutral-300 uppercase tracking-wider">
                  Deliverables &amp; Master Storage Links
                </div>

                <div className="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
                  <div className="p-3 rounded-lg bg-neutral-900 border border-neutral-800">
                    <span className="text-[11px] text-neutral-400 block mb-1">Master Google Drive:</span>
                    {selectedShoot.masterDriveLink ? (
                      <a
                        href={selectedShoot.masterDriveLink}
                        target="_blank"
                        rel="noreferrer"
                        className="text-amber-400 hover:underline flex items-center gap-1 font-mono text-[11px]"
                      >
                        <ExternalLink className="w-3 h-3" />
                        <span>Open Drive Folder</span>
                      </a>
                    ) : (
                      <span className="text-neutral-500 italic">No link assigned</span>
                    )}
                  </div>

                  <div className="p-3 rounded-lg bg-neutral-900 border border-neutral-800">
                    <span className="text-[11px] text-neutral-400 block mb-1">4K Teaser / Reel Link:</span>
                    {selectedShoot.teaserVideoLink ? (
                      <a
                        href={selectedShoot.teaserVideoLink}
                        target="_blank"
                        rel="noreferrer"
                        className="text-amber-400 hover:underline flex items-center gap-1 font-mono text-[11px]"
                      >
                        <ExternalLink className="w-3 h-3" />
                        <span>Watch Teaser</span>
                      </a>
                    ) : (
                      <span className="text-neutral-500 italic">No video linked</span>
                    )}
                  </div>

                  <div className="p-3 rounded-lg bg-neutral-900 border border-neutral-800">
                    <span className="text-[11px] text-neutral-400 block mb-1">Raw Footage Vault:</span>
                    {selectedShoot.rawBackupLink ? (
                      <a
                        href={selectedShoot.rawBackupLink}
                        target="_blank"
                        rel="noreferrer"
                        className="text-amber-400 hover:underline flex items-center gap-1 font-mono text-[11px]"
                      >
                        <ExternalLink className="w-3 h-3" />
                        <span>Access Raw Vault</span>
                      </a>
                    ) : (
                      <span className="text-neutral-500 italic">Internal Studio Archive</span>
                    )}
                  </div>
                </div>
              </div>

              {/* Photo Proofing Gallery */}
              <div className="space-y-4">
                <div className="flex items-center justify-between">
                  <div>
                    <h3 className="text-sm font-semibold text-white flex items-center gap-2">
                      <Sparkles className="w-4 h-4 text-amber-400" />
                      <span>Shoot Photo Proofs Gallery</span>
                    </h3>
                    <p className="text-xs text-neutral-400 mt-0.5">
                      Photos uploaded for client to proof, favorite, and select for album print.
                    </p>
                  </div>

                  <button
                    onClick={() => setIsAddPhotoOpen(true)}
                    className="flex items-center gap-1.5 px-3 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-white text-xs font-medium rounded-lg border border-neutral-700 transition-colors"
                  >
                    <Upload className="w-3.5 h-3.5 text-amber-400" />
                    <span>Upload Proofs</span>
                  </button>
                </div>

                {/* Photos Grid */}
                <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                  {getShootPhotos(selectedShoot.id).map((photo, idx) => (
                    <div
                      key={photo.id}
                      onClick={() => {
                        setCurrentPhotoIdx(idx);
                        setLightboxOpen(true);
                      }}
                      className="relative rounded-lg overflow-hidden border border-neutral-800 group bg-neutral-950 aspect-square cursor-pointer"
                    >
                      <img
                        src={photo.url}
                        alt={photo.title}
                        referrerPolicy="no-referrer"
                        className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                      <div className="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />

                      {/* Top Badges */}
                      <div className="absolute top-2 right-2 flex items-center gap-1">
                        {photo.isSelectedForAlbum && (
                          <span className="p-1 rounded bg-amber-500 text-neutral-950 font-bold" title="Selected for Album">
                            <Check className="w-3 h-3 stroke-[3]" />
                          </span>
                        )}
                        {photo.isFavorite && (
                          <span className="p-1 rounded bg-rose-500 text-white" title="Favorited">
                            <Heart className="w-3 h-3 fill-white" />
                          </span>
                        )}
                      </div>

                      {/* Bottom Info */}
                      <div className="absolute bottom-2 left-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
                        <div className="text-[11px] font-medium text-white truncate">
                          {photo.title || 'Untitled'}
                        </div>
                        {photo.clientNotes && (
                          <div className="text-[10px] text-amber-300 truncate">
                            Note: {photo.clientNotes}
                          </div>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Add Photo Modal */}
      {isAddPhotoOpen && selectedShoot && (
        <div className="fixed inset-0 z-50 bg-neutral-950/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="relative w-full max-w-md bg-neutral-900 border border-neutral-800 rounded-xl shadow-2xl overflow-hidden p-6 space-y-4">
            <div className="flex items-center justify-between pb-3 border-b border-neutral-800">
              <h3 className="text-sm font-semibold text-white">Add Photo Proof to Shoot</h3>
              <button
                onClick={() => setIsAddPhotoOpen(false)}
                className="p-1 text-neutral-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <form onSubmit={handleAddPhotoSubmit} className="space-y-4 text-xs">
              <div>
                <label className="block text-neutral-300 font-medium mb-1">Image URL or Path *</label>
                <input
                  type="text"
                  required
                  value={newPhotoUrl}
                  onChange={(e) => setNewPhotoUrl(e.target.value)}
                  placeholder="https://... or image asset URL"
                  className="w-full bg-neutral-950 border border-neutral-700 rounded-lg px-3 py-2 text-white placeholder-neutral-500 focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-neutral-300 font-medium mb-1">Photo Title / Caption</label>
                <input
                  type="text"
                  value={newPhotoTitle}
                  onChange={(e) => setNewPhotoTitle(e.target.value)}
                  placeholder="e.g. Ring Exchange, Drone Top Down"
                  className="w-full bg-neutral-950 border border-neutral-700 rounded-lg px-3 py-2 text-white placeholder-neutral-500 focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-neutral-300 font-medium mb-1">Category / Tag</label>
                <input
                  type="text"
                  value={newPhotoCategory}
                  onChange={(e) => setNewPhotoCategory(e.target.value)}
                  placeholder="e.g. Candid, Rituals, Portraits"
                  className="w-full bg-neutral-950 border border-neutral-700 rounded-lg px-3 py-2 text-white placeholder-neutral-500 focus:outline-none focus:border-amber-500"
                />
              </div>

              <div className="flex items-center justify-end gap-2 pt-3 border-t border-neutral-800">
                <button
                  type="button"
                  onClick={() => setIsAddPhotoOpen(false)}
                  className="px-3 py-1.5 text-neutral-400 hover:text-white"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-4 py-1.5 bg-amber-500 hover:bg-amber-400 text-neutral-950 font-semibold rounded-lg transition-colors"
                >
                  Add Proof
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Lightbox */}
      {selectedShoot && (
        <PhotoLightbox
          photos={getShootPhotos(selectedShoot.id)}
          currentIndex={currentPhotoIdx}
          isOpen={lightboxOpen}
          onClose={() => setLightboxOpen(false)}
          onNavigate={(idx) => setCurrentPhotoIdx(idx)}
        />
      )}
    </div>
  );
};
