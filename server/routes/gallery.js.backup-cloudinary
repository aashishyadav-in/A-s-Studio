import express from "express";
import auth from "../middleware/auth.js";
import Shoot from "../models/shoot.js";
import Photo from "../models/photo.js";

const router = express.Router();

const shootFields = [
  "id", "clientId", "title", "type", "eventDate", "venue",
  "leadPhotographer", "crewMembers", "status", "packageTitle",
  "totalAmount", "advancePaid", "balanceDue", "masterDriveLink",
  "teaserVideoLink", "rawBackupLink", "notes", "coverImage",
  "photosCount", "selectedPhotosCount",
];

const photoFields = [
  "id", "shootId", "url", "title", "category",
  "isSelectedForAlbum", "isFavorite", "clientNotes",
  "uploadedAt", "resolution", "width", "height",
];

function pickFields(source, allowedFields) {
  return Object.fromEntries(
    allowedFields
      .filter((key) => source[key] !== undefined)
      .map((key) => [key, source[key]])
  );
}

// GET /api/gallery/me
router.get("/me", auth, async (req, res) => {
  try {
    let filter = {};

    if (req.auth.role === "CLIENT" && req.auth.clientId) {
      filter.clientId = req.auth.clientId;
    } else if (req.auth.role !== "ADMIN") {
      return res.status(403).json({ message: "Access denied." });
    }

    const shoots = await Shoot.find(filter).lean();
    const shootIds = shoots.map((shoot) => shoot.id);

    const photos = shootIds.length
      ? await Photo.find({ shootId: { $in: shootIds } }).lean()
      : [];

    return res.json({ shoots, photos });
  } catch (error) {
    console.error("Gallery API error:", error.message);
    return res.status(500).json({ message: "Unable to load gallery." });
  }
});

// POST /api/gallery/migrate — ADMIN ONLY
// Imports existing frontend gallery records without deleting other records.
router.post("/migrate", auth, async (req, res) => {
  try {
    if (req.auth.role !== "ADMIN") {
      return res.status(403).json({ message: "Admin access required." });
    }

    const { shoots, photos } = req.body || {};

    if (!Array.isArray(shoots) || !Array.isArray(photos)) {
      return res.status(400).json({
        message: "Both shoots and photos must be arrays.",
      });
    }

    if (shoots.length > 1000 || photos.length > 10000) {
      return res.status(413).json({ message: "Migration payload too large." });
    }

    const validShootIds = new Set(
      shoots
        .filter((item) => item && typeof item.id === "string" && item.id)
        .map((item) => item.id)
    );

    if (validShootIds.size !== shoots.length) {
      return res.status(400).json({
        message: "Every shoot must have a unique, non-empty string ID.",
      });
    }

    if (
      photos.some(
        (photo) =>
          !photo ||
          typeof photo.id !== "string" ||
          !photo.id ||
          typeof photo.shootId !== "string" ||
          !photo.shootId
      )
    ) {
      return res.status(400).json({
        message: "Every photo must have a non-empty ID and shootId.",
      });
    }

        const photoIds = photos.map((photo) => photo.id);

    if (new Set(photoIds).size !== photoIds.length) {
      return res.status(400).json({
        message: "Every photo must have a unique ID.",
      });
    }

    const existingShootIds = new Set(
      (await Shoot.find({}, { id: 1, _id: 0 }).lean()).map(
        (shoot) => shoot.id
      )
    );

    for (const shootId of validShootIds) {
      existingShootIds.add(shootId);
    }

    const invalidPhoto = photos.find(
      (photo) => !existingShootIds.has(photo.shootId)
    );

    if (invalidPhoto) {
      return res.status(400).json({
        message: `Photo "${invalidPhoto.id}" references an unknown shoot.`,
      });
    }

    const shootOps = shoots.map((shoot) => {
      const data = pickFields(shoot, shootFields);
      return {
        updateOne: {
          filter: { id: data.id },
         update: { $setOnInsert: data },
          upsert: true,
        },
      };
    });

    const photoOps = photos.map((photo) => {
      const data = pickFields(photo, photoFields);
      return {
        updateOne: {
          filter: { id: data.id },
         update: { $setOnInsert: data },
          upsert: true,
        },
      };
    });

    if (shootOps.length) await Shoot.bulkWrite(shootOps);
    if (photoOps.length) await Photo.bulkWrite(photoOps);

    return res.json({
      message: "Gallery migration completed.",
      shootsProcessed: shootOps.length,
      photosProcessed: photoOps.length,
    });
  } catch (error) {
    console.error("Gallery migration error:", error.message);
    return res.status(500).json({ message: "Gallery migration failed." });
  }
});


function requireAdmin(req, res) {
  if (req.auth.role !== "ADMIN") {
    res.status(403).json({ message: "Admin access required." });
    return false;
  }
  return true;
}

// CREATE SHOOT
router.post("/shoots", auth, async (req, res) => {
  try {
    if (!requireAdmin(req, res)) return;

    const data = pickFields(req.body || {}, shootFields);

    if (!data.id || !data.clientId || !data.title) {
      return res.status(400).json({
        message: "Shoot ID, client ID and title are required.",
      });
    }

    const shoot = await Shoot.create(data);
    return res.status(201).json({ shoot });
  } catch (error) {
    if (error.code === 11000) {
      return res.status(409).json({ message: "Shoot ID already exists." });
    }
    console.error("Create shoot error:", error.message);
    return res.status(500).json({ message: "Unable to create shoot." });
  }
});

// UPDATE SHOOT
router.patch("/shoots/:id", auth, async (req, res) => {
  try {
    if (!requireAdmin(req, res)) return;

    const fields = shootFields.filter((key) => key !== "id");
    const updates = pickFields(req.body || {}, fields);

    if (!Object.keys(updates).length) {
      return res.status(400).json({ message: "No valid shoot fields provided." });
    }

    const shoot = await Shoot.findOneAndUpdate(
      { id: req.params.id },
      { $set: updates },
      { new: true, runValidators: true }
    ).lean();

    if (!shoot) {
      return res.status(404).json({ message: "Shoot not found." });
    }

    return res.json({ shoot });
  } catch (error) {
    console.error("Update shoot error:", error.message);
    return res.status(500).json({ message: "Unable to update shoot." });
  }
});

// DELETE SHOOT AND ITS PHOTOS
router.delete("/shoots/:id", auth, async (req, res) => {
  try {
    if (!requireAdmin(req, res)) return;

    const shoot = await Shoot.findOneAndDelete({ id: req.params.id });

    if (!shoot) {
      return res.status(404).json({ message: "Shoot not found." });
    }

    await Photo.deleteMany({ shootId: req.params.id });

    return res.json({ message: "Shoot and associated photos deleted." });
  } catch (error) {
    console.error("Delete shoot error:", error.message);
    return res.status(500).json({ message: "Unable to delete shoot." });
  }
});

// CREATE PHOTO
router.post("/photos", auth, async (req, res) => {
  try {
    if (!requireAdmin(req, res)) return;

    const data = pickFields(req.body || {}, photoFields);

    if (!data.id || !data.shootId || !data.url) {
      return res.status(400).json({
        message: "Photo ID, shoot ID and URL are required.",
      });
    }

    const shootExists = await Shoot.exists({ id: data.shootId });

    if (!shootExists) {
      return res.status(400).json({ message: "Referenced shoot does not exist." });
    }

    const photo = await Photo.create(data);
    return res.status(201).json({ photo });
  } catch (error) {
    if (error.code === 11000) {
      return res.status(409).json({ message: "Photo ID already exists." });
    }
    console.error("Create photo error:", error.message);
    return res.status(500).json({ message: "Unable to create photo." });
  }
});

// DELETE PHOTO
router.delete("/photos/:id", auth, async (req, res) => {
  try {
    if (!requireAdmin(req, res)) return;

    const photo = await Photo.findOneAndDelete({ id: req.params.id });

    if (!photo) {
      return res.status(404).json({ message: "Photo not found." });
    }

    return res.json({ message: "Photo deleted." });
  } catch (error) {
    console.error("Delete photo error:", error.message);
    return res.status(500).json({ message: "Unable to delete photo." });
  }
});

// PATCH /api/gallery/photos/:id
// Clients may update only photos belonging to their own shoots.
router.patch("/photos/:id", auth, async (req, res) => {
  try {
    const allowedKeys = [
      "isSelectedForAlbum",
      "isFavorite",
      "clientNotes",
    ];

    const updates = pickFields(req.body || {}, allowedKeys);
    const keys = Object.keys(updates);

    if (
      keys.length === 0 ||
      keys.some((key) =>
        ["isSelectedForAlbum", "isFavorite"].includes(key) &&
        typeof updates[key] !== "boolean"
      ) ||
      (updates.clientNotes !== undefined &&
        typeof updates.clientNotes !== "string")
    ) {
      return res.status(400).json({ message: "Invalid photo update." });
    }

    const photo = await Photo.findOne({ id: req.params.id }).lean();

    if (!photo) {
      return res.status(404).json({ message: "Photo not found." });
    }

    if (req.auth.role === "CLIENT") {
      if (!req.auth.clientId) {
        return res.status(403).json({ message: "Client access denied." });
      }

      const shoot = await Shoot.findOne({
        id: photo.shootId,
        clientId: req.auth.clientId,
      }).lean();

      if (!shoot) {
        return res.status(403).json({ message: "Photo access denied." });
      }
    } else if (req.auth.role !== "ADMIN") {
      return res.status(403).json({ message: "Access denied." });
    }

    const updated = await Photo.findOneAndUpdate(
      { id: req.params.id },
      { $set: updates },
      { new: true, runValidators: true }
    ).lean();

    return res.json({ photo: updated });
  } catch (error) {
    console.error("Photo update error:", error.message);
    return res.status(500).json({ message: "Unable to update photo." });
  }
});

export default router;
