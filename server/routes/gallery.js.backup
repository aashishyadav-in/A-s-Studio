import express from "express";
import auth from "../middleware/auth.js";
import Shoot from "../models/shoot.js";
import Photo from "../models/photo.js";

const router = express.Router();

// GET /api/gallery/me
router.get("/me", auth, async (req, res) => {
  try {
    let shoots;

    if (req.auth.role === "ADMIN") {
      shoots = await Shoot.find({}).lean();
    } else if (req.auth.role === "CLIENT" && req.auth.clientId) {
      shoots = await Shoot.find({
        clientId: req.auth.clientId,
      }).lean();
    } else {
      return res.status(403).json({
        message: "Valid client or admin access required.",
      });
    }

    const shootIds = shoots.map((shoot) => shoot.id);

    const photos = shootIds.length
      ? await Photo.find({ shootId: { $in: shootIds } }).lean()
      : [];

    return res.json({ shoots, photos });
  } catch (error) {
    console.error("Gallery API error:", error.message);
    return res.status(500).json({
      message: "Unable to load gallery.",
    });
  }
});

export default router;
